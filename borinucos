#!/usr/bin/env bash
# Generate the 50 "borinucos" (ArUco markers for Borinots) into a folder,
# as STL and as sliced G-code for a Prusa MK3S (PETG, with a color change).
# Box side depends on marker ID:
#   0..20  -> 100 mm
#   21..30 ->  40 mm
#   31..49 -> 170 mm
# Margin is 10% of the box side (10 mm for a 100 mm box).
# Usage: ./borinucos [output_dir]   (default: borinucos_out)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT_DIR="${1:-borinucos_out}"
if [[ -x "$SCRIPT_DIR/aruco_3d_env/bin/python" ]]; then
    PYTHON="${PYTHON:-$SCRIPT_DIR/aruco_3d_env/bin/python}"
else
    PYTHON="${PYTHON:-python3}"
fi
PRUSA_SLICER="${PRUSA_SLICER:-/Applications/Original Prusa Drivers/PrusaSlicer.app/Contents/MacOS/PrusaSlicer}"
SLICER_CONFIG="${SLICER_CONFIG:-$SCRIPT_DIR/borinucos-mk3s-petg.ini}"

BOX_THICKNESS=2.1
GROOVE_DEPTH=0.85
# Groove floor measured from the bed: the color changes above it.
COLOR_CHANGE_Z=$(awk -v t="$BOX_THICKNESS" -v g="$GROOVE_DEPTH" 'BEGIN { print t - g }')

mkdir -p "$OUT_DIR"

for ID in $(seq 0 49); do
    if   (( ID <= 20 )); then SIDE=100
    elif (( ID <= 30 )); then SIDE=40
    else                      SIDE=170
    fi
    MARGIN=$(awk -v s="$SIDE" 'BEGIN { print s / 10 }')
    NAME="$OUT_DIR/borinuco$ID"
    echo "==> borinuco$ID (box_side=$SIDE, marker_margin=$MARGIN)"
    "$PYTHON" "$SCRIPT_DIR/generate_aruco.py" \
        --box_side "$SIDE" \
        --marker_margin "$MARGIN" \
        --box_thickness "$BOX_THICKNESS" \
        --marker_groove_depth "$GROOVE_DEPTH" \
        --aruco_dictionary DICT_6X6_50 \
        --layer_height 1 \
        --marker_id "$ID" \
        --output "$NAME" >/dev/null
    # PrusaSlicer CLI sometimes hangs idle: retry with a timeout.
    for TRY in 1 2 3; do
        if timeout 300 "$PRUSA_SLICER" --export-gcode \
            --load "$SLICER_CONFIG" \
            --center 125,105 \
            --output "$NAME.gcode" \
            "$NAME.stl" >/dev/null; then
            break
        fi
        (( TRY == 3 )) && { echo "borinuco$ID: slicing failed" >&2; exit 1; }
        echo "borinuco$ID: slicing hung or failed, retrying" >&2
    done
    "$PYTHON" "$SCRIPT_DIR/insert_color_change.py" --z "$COLOR_CHANGE_Z" "$NAME.gcode"
done
